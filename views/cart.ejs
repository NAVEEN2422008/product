<%- include('partials/header') %>

<section class="page-header">
  <div class="container">
    <span class="section-label">Cart</span>
    <h1>Shopping Cart</h1>
    <p><%= cartItems.length %> item(s) in your cart</p>
  </div>
</section>

<section class="cart-page" style="padding-top: 40px;">
  <div class="container">
    <% if (cartItems.length === 0) { %>
      <div class="empty-state">
        <span class="icon">🛒</span>
        <h2>Your cart is empty</h2>
        <p>Looks like you haven't added anything yet. Start exploring our products!</p>
        <a href="/products" class="btn btn-primary">Browse Products</a>
      </div>
    <% } else { %>
      <div class="cart-layout">
        <div class="cart-items">
          <% cartItems.forEach((item, index) => { %>
            <div class="cart-item">
              <div class="cart-item-image">
                <img src="<%= item.product.image %>" alt="<%= item.product.name %>">
              </div>
              <div class="cart-item-info">
                <h3><%= item.product.name %></h3>
                <% if (item.customText) { %><p class="cart-custom">Custom: <strong><%= item.customText %></strong></p><% } %>
                <% if (item.color) { %><p class="cart-custom">Color: <%= item.color %></p><% } %>
                <% if (item.size) { %><p class="cart-custom">Size: <%= item.size %></p><% } %>
                <p class="cart-price">₹<%= (item.product.price * item.quantity).toLocaleString() %></p>
              </div>
              <div class="cart-item-actions">
                <form method="POST" action="/cart/update" class="cart-qty-form">
                  <input type="hidden" name="index" value="<%= index %>">
                  <button type="submit" name="quantity" value="<%= item.quantity - 1 %>" class="qty-btn" <%= item.quantity <= 1 ? 'disabled' : '' %>>−</button>
                  <span class="qty-display"><%= item.quantity %></span>
                  <button type="submit" name="quantity" value="<%= item.quantity + 1 %>" class="qty-btn">+</button>
                </form>
                <form method="POST" action="/cart/remove">
                  <input type="hidden" name="index" value="<%= index %>">
                  <button type="submit" class="btn-remove">Remove</button>
                </form>
              </div>
            </div>
          <% }) %>
        </div>
        <div class="cart-summary">
          <h3>Order Summary</h3>
          <div class="summary-row">
            <span>Subtotal</span>
            <span>₹<%= subtotal.toLocaleString() %></span>
          </div>
          <div class="summary-row">
            <span>Shipping</span>
            <span><%= subtotal >= 499 ? 'FREE' : '₹99' %></span>
          </div>
          <div class="summary-row summary-total">
            <span>Total</span>
            <span>₹<%= (subtotal + (subtotal >= 499 ? 0 : 99)).toLocaleString() %></span>
          </div>
          <% if (subtotal < 499) { %>
            <p class="free-shipping-msg">Add ₹<%= (499 - subtotal).toLocaleString() %> more for free shipping!</p>
          <% } else { %>
            <p class="free-shipping-msg success">🎉 You qualify for free shipping!</p>
          <% } %>
          <a href="/checkout" class="btn btn-primary btn-block">Proceed to Checkout</a>
          <a href="/products" class="btn btn-ghost btn-block btn-sm" style="margin-top: 8px;">Continue Shopping</a>
        </div>
      </div>
    <% } %>
  </div>
</section>

<%- include('partials/footer') %>
