<%- include('partials/header') %>

<section class="success-page">
  <div class="container">
    <div class="success-card">
      <div class="success-icon">✅</div>
      <h1>Order Confirmed!</h1>
      <p>Thank you, <strong><%= order.customer.name %></strong>! Your order is being processed.</p>
      <div class="order-details">
        <div class="order-detail-row">
          <span>Order ID</span>
          <span class="order-id"><%= order.id %></span>
        </div>
        <div class="order-detail-row">
          <span>Date</span>
          <span><%= order.date %></span>
        </div>
        <div class="order-detail-row">
          <span>Total</span>
          <span style="color: var(--primary-light); font-weight: 700;">₹<%= order.total.toLocaleString() %></span>
        </div>
        <div class="order-detail-row">
          <span>Payment</span>
          <span><%= order.paymentMethod %></span>
        </div>
        <div class="order-detail-row">
          <span>Status</span>
          <span class="status-confirmed"><%= order.status %></span>
        </div>
      </div>
      <h3 style="font-size: 1rem; margin-bottom: 16px; text-align: left;">Items Ordered</h3>
      <div class="success-items">
        <% order.items.forEach(item => { %>
          <div class="success-item">
            <span><%= item.productName %></span>
            <span>× <%= item.quantity %></span>
            <span>₹<%= (item.productPrice * item.quantity).toLocaleString() %></span>
          </div>
        <% }) %>
      </div>
      <p class="success-msg">We'll start working on your order right away! You'll receive a confirmation email shortly.</p>
      <div class="success-actions">
        <a href="/" class="btn btn-primary">Back to Home</a>
        <a href="/products" class="btn btn-outline">Continue Shopping</a>
      </div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
